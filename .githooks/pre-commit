#!/usr/bin/env bash
set -euo pipefail

echo "🔍 Pre-commit: проверка staged-файлов..."

staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$staged" ]; then
    echo "✅ Нет staged-файлов для проверки"
    exit 0
fi

errors=0

check_nix() {
    local f="$1"
    if ! command -v nix-instantiate &>/dev/null; then
        return 0
    fi

    # eval: глубокая проверка (undefined vars, missing imports)
    if nix-instantiate --eval "$f" &>/dev/null; then
        return 0
    fi

    # fallback: если eval упал (напр. функция без аргументов), проверяем синтаксис
    if nix-instantiate --parse "$f" &>/dev/null; then
        return 0
    fi

    # обе проверки упали — показываем ошибку eval
    echo "❌ $f — ошибка Nix"
    nix-instantiate --eval "$f" 2>&1 | head -5
    return 1
}

check_py() {
    local f="$1"
    if command -v python &>/dev/null; then
        if ! python -m py_compile "$f" 2>/dev/null; then
            echo "❌ $f — синтаксическая ошибка Python"
            python -m py_compile "$f" 2>&1 | head -5
            return 1
        fi
    fi
}

check_json() {
    local f="$1"
    if command -v python &>/dev/null; then
        if ! python -m json.tool "$f" &>/dev/null; then
            echo "❌ $f — некорректный JSON"
            python -m json.tool "$f" 2>&1 | head -5
            return 1
        fi
    fi
}

check_lua() {
    local f="$1"

    local luac_bin
    luac_bin=$(command -v luac || find /nix/store -maxdepth 3 -name luac -type f 2>/dev/null | head -1)
    local lua_bin
    lua_bin=$(command -v lua || find /nix/store -maxdepth 3 -name lua -type f 2>/dev/null | head -1)

    if [ -n "$luac_bin" ] && "$luac_bin" -p "$f" &>/dev/null; then
        return 0
    fi

    if [ -n "$lua_bin" ] && "$lua_bin" -e "loadfile('$f')" &>/dev/null; then
        return 0
    fi

    if [ -n "$luac_bin" ]; then
        echo "❌ $f — синтаксическая ошибка Lua"
        "$luac_bin" -p "$f" 2>&1 | head -5
    elif [ -n "$lua_bin" ]; then
        echo "❌ $f — синтаксическая ошибка Lua"
        "$lua_bin" -e "loadfile('$f')" 2>&1 | head -5
    fi
    return 1
}

while IFS= read -r f; do
    [ -z "$f" ] && continue
    [ ! -f "$f" ] && continue

    case "$f" in
        *.nix)   check_nix "$f"   || errors=$((errors + 1)) ;;
        *.py)    check_py "$f"    || errors=$((errors + 1)) ;;
        *.json)  check_json "$f"  || errors=$((errors + 1)) ;;
        *.lua)   check_lua "$f"   || errors=$((errors + 1)) ;;
    esac
done <<< "$staged"

if [ "$errors" -gt 0 ]; then
    echo "❌ Найдено $errors ошибок. Коммит отменён."
    exit 1
fi

echo "✅ Все staged-файлы в порядке"
