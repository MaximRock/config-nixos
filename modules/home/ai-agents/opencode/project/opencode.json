{
    "$schema": "https://opencode.ai/config.json",
    "model": "llama.cpp/qwen3-coder-30b",
    "instructions": [
        "promt-help.md",
        "AGENTS.md",
        "AI-MODULE-GUIDE.md"
    ],
    "lsp": true,
    "provider": {
        "llama.cpp": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama-server (local)",
            "options": {
                "baseURL": "http://127.0.0.1:8080/v1"
            },
            "models": {
                "qwen3-coder-30b": {
                    "name": "Qwen3-Coder-30B-A3B (local)",
                    "supportsToolCalls": true,
                    "limit": {
                        "context": 24576,
                        "input": 24576,
                        "output": 8192
                    }
                }
            }
        }
    },
    "mcp": {
        "dotfiles-helper": {
            "type": "local",
            "command": [
                "mcp-dotfiles-helper"
            ],
            "environment": {
                "DOTFILES_REPO": "/home/max/.dotfiles"
            }
        },
        "rime": {
            "type": "local",
            "command": [
                "rime",
                "stdio"
            ],
            "enabled": true
        },
        "graft": {
            "type": "local",
            "command": [
                "graft",
                "mcp"
            ],
            "enabled": true
        }
    },
    "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "write": "allow"
    }
}
