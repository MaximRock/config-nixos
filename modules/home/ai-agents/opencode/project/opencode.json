{
    "$schema": "https://opencode.ai/config.json",
    "model": "llama.cpp/ornith-9b",
    "instructions": [
        "AGENTS.md"
    ],
    "lsp": true,
    "tools": {
        "dotfiles-helper_*": false,
        "graft_*": false,
        "rime_*": false
    },
    "provider": {
        "llama.cpp": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama-server (local)",
            "options": {
                "baseURL": "http://127.0.0.1:8080/v1"
            },
            "models": {
                "ornith-9b": {
                    "name": "Ornith-1.5-9B (local)",
                    "supportsToolCalls": true,
                    "limit": {
                        "context": 65536,
                        "input": 65536,
                        "output": 8192
                    }
                }
            }
        }
    },
    "default_agent": "local",
    "agent": {
        "local": {
            "description": "Локальная модель llama.cpp/ornith-9b, урезанный MCP",
            "mode": "primary",
            "model": "llama.cpp/ornith-9b",
            "prompt": "{file:modules/home/ai-agents/opencode/project/prompts/local.md}"
        },
        "build": {
            "tools": {
                "dotfiles-helper_*": true,
                "graft_*": true,
                "rime_*": true
            }
        },
        "plan": {
            "tools": {
                "dotfiles-helper_*": true,
                "graft_*": true,
                "rime_*": true
            }
        }
    },
    "mcp": {
        "dotfiles-helper": {
            "type": "local",
            "command": [
                "mcp-dotfiles-helper"
            ],
            "environment": {
                "DOTFILES_REPO": "/home/max/.dotfiles"
            }
        },
        "rime": {
            "type": "local",
            "command": [
                "rime",
                "stdio"
            ],
            "enabled": true
        },
        "graft": {
            "type": "local",
            "command": [
                "graft",
                "mcp"
            ],
            "enabled": true
        },
        "nix-repo-navigator": {
            "type": "local",
            "command": [
                "nix-repo-navigator",
                "start",
                "--root",
                "/home/max/.dotfiles"
            ],
            "enabled": true
        }
    },
    "plugin": ["@dietrichgebert/ponytail"],
    "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "write": "allow"
    }
}
