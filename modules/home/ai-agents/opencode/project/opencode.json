{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "AGENTS.md"
    ],
    "lsp": true,
    
    "provider": {
        "llama.cpp": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama-server (local)",
            "options": {
                "baseURL": "http://127.0.0.1:8080/v1"
            },
            "models": {
                "qwen3-coder-30b": {
                    "name": "Qwen3-Coder-30B-A3B (local)",
                    "limit": {
                        "context": 65536,
                        "input": 65536,
                        "output": 8192
                    }
                }
            }
        }
    },
    
    "mcp": {
        "dotfiles-helper": {
            "type": "local",
            "command": [
                "mcp-dotfiles-helper"
            ],
            "environment": {
                "DOTFILES_REPO": "/home/max/.dotfiles"
            }
        },
        "rime": {
            "type": "local",
            "command": [
                "rime",
                "stdio"
            ],
            "enabled": true
        },
        "graft": {
            "type": "local",
            "command": [
                "graft",
                "mcp"
            ],
            "enabled": true
        },
        "graft-navigator": {
            "type": "local",
            "command": [
                "graft",
                "mcp",
                "/home/max/projects/repo-navigator"
            ],
            "enabled": true
        },
        "nix-repo-navigator": {
            "type": "local",
            "command": [
                "nix-repo-navigator",
                "start",
                "--root",
                "/home/max/.dotfiles",
                "--plugins",
                "python",
                "--parse-unreferenced"
            ],
            "enabled": true
        }
    },
    "plugin": ["@dietrichgebert/ponytail"],
    "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "write": "allow"
    }
}
