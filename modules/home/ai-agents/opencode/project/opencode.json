{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "AGENTS.md"
    ],
    "lsp": true,
    
    "mcp": {
        "dotfiles-helper": {
            "type": "local",
            "command": [
                "env",
                "-u",
                "PYTHONPATH",
                "mcp-dotfiles-helper"
            ],
            "environment": {
                "DOTFILES_REPO": "/home/max/.dotfiles"
            }
        },
        "rime": {
            "type": "local",
            "command": [
                "rime",
                "stdio"
            ],
            "enabled": true
        },
        "nix-repo-navigator": {
            "type": "local",
            "command": [
                "env",
                "-u",
                "PYTHONPATH",
                "nix-repo-navigator",
                "start",
                "--root",
                "/home/max/.dotfiles",
                "--plugins",
                "python",
                "--parse-unreferenced",
                "--exclude",
                "11"
            ],
            "enabled": true
        }
    },
    "plugin": ["@dietrichgebert/ponytail"],
    "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "write": "allow"
    }
}
