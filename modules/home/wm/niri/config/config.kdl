include "theme.kdl"
include "input.kdl"
include "binds.kdl"

layout {
    gaps 4
    border {
        width 1
    }
}

// Именованные столы — фиксируем нумерацию: niri ставит именованные в начало
workspace "1"
workspace "2"
workspace "3"

window-rule {
    match app-id="pavucontrol"
    open-floating true
}
window-rule {
    match app-id="blueman-manager"
    open-floating true
}

// Окно настроек Noctalia — плавающее, фиксированного размера
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Авто-инстанс Throne (запускается при старте niri) — на рабочем столе 2
window-rule {
    match at-startup=true app-id=r#"^Throne$"#
    open-on-workspace "2"
}

// Разрешает действия уведомлений и активацию окон из Noctalia
debug {
    honor-xdg-activation-with-invalid-serial
}

// Подложка Noctalia (blurred backdrop) видна в overview
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

// «Матовое стекло» позади дашборда-«райдера» (eww, namespace eww-dashboard).
// Слой полноэкранный → размывается весь фон стола 3 (карточки полупрозрачны).
layer-rule {
    match namespace="^eww-dashboard$"
    background-effect {
        blur false 
    }
}

spawn-at-startup "noctalia"
spawn-at-startup "lxqt-policykit-agent"
spawn-at-startup "Throne"

// Дашборд-«райдер» на столе 3 (eww). Демон + разовое открытие окна: дальше окно
// висит всегда (история графиков не сбрасывается), а видимость по столу eww
// решает сам через poll focused_wsp и :visible.
spawn-at-startup "eww" "daemon"
spawn-at-startup "sh" "-c" "until eww ping >/dev/null 2>&1; do sleep 0.2; done; eww open dashboard"
