include "theme.kdl"
include "input.kdl"
include "binds.kdl"

layout {
    gaps 4
    border {
        width 1
    }
}

// Именованные столы — фиксируем нумерацию: niri ставит именованные в начало
workspace "1"
workspace "2"
workspace "3"

window-rule {
    match app-id="pavucontrol"
    open-floating true
}
window-rule {
    match app-id="blueman-manager"
    open-floating true
}

// Окно настроек Noctalia — плавающее, фиксированного размера
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Авто-инстанс Throne (запускается при старте niri) — на рабочем столе 2
window-rule {
    match at-startup=true app-id=r#"^Throne$"#
    open-on-workspace "2"
}

// btop-«дашборд» на столе 3: матовое стекло поверх обоев
window-rule {
    match app-id=r#"^btop$"#
    open-on-workspace "3"
    open-maximized-to-edges true
    open-focused false
    focus-ring {
        off
    }
    geometry-corner-radius 20
    clip-to-geometry true
    background-effect {
        blur true
        saturation 1.15
        noise 0.02
    }
}

// Разрешает действия уведомлений и активацию окон из Noctalia
debug {
    honor-xdg-activation-with-invalid-serial
}

// Тема курсора (wezterm/Noctalia/Thunar наследуют XCURSOR_THEME/SIZE от niri)
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

// Оверлей хоткеев не показывать при старте (открывается вручную: Mod+Shift+Slash)
hotkey-overlay {
    skip-at-startup
}

spawn-at-startup "noctalia"
spawn-at-startup "Throne"

// btop-«дашборд» на столе 3: отдельный процесс wezterm с app-id btop.
// Полупрозрачный терминал + blur из window-rule = матовое стекло.
spawn-at-startup "sh" "-c" "exec wezterm --config window_background_opacity=0.78 start --class btop --always-new-process -- btop"
