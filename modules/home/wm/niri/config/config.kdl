include "theme.kdl"
include "input.kdl"
include "binds.kdl"

layout {
    gaps 4
    border {
        width 1
    }
}

window-rule {
    match app-id="pavucontrol"
    open-floating true
}
window-rule {
    match app-id="blueman-manager"
    open-floating true
}

spawn-at-startup "swaybg" "-i" "/run/current-system/sw/share/backgrounds/nixos/nix-wallpaper-nineish-dark-gray.png" "-m" "fill"
spawn-at-startup "mako"
spawn-at-startup "waybar"
spawn-at-startup "lxqt-policykit-agent"
spawn-at-startup "swayidle" "-w" "timeout" "300" "swaylock -f -c 1e1e2e" "timeout" "600" "swaylock -f -c 1e1e2e"
