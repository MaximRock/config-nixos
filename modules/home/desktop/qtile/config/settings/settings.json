{
  "theme": {
    "active": "catppuccin",
    "colors": {}
  },
  "fonts": {
    "mono": "JetBrainsMono Nerd Font Mono",
    "sans": "JetBrainsMono Nerd Font",
    "size": 14
  },
  "apps": {
    "terminal": "wezterm",
    "browser": "yandex-browser-stable",
    "file_manager": "thunar",
    "editor": "codium",
    "rofi": "rofi -show drun",
    "flameshot_gui": "flameshot gui",
    "flameshot_full": "flameshot full"
  },
  "dunst": {
    "font": "JetBrainsMonoNL Nerd Font",
    "font_size": 10,
    "width": 300,
    "height": 100,
    "origin": "top-right",
    "offset": "10x10",
    "transparency": 10,
    "corner_radius": 8,
    "frame_width": 2,
    "padding": 8,
    "horizontal_padding": 12,
    "text_icon_padding": 8,
    "icon_position": "left",
    "max_icon_size": 64,
    "follow": "mouse",
    "notification_limit": 5,
    "word_wrap": true,
    "ellipsize": "middle",
    "format": "<b>%s</b>\n%b",
    "stack_duplicates": true,
    "hide_duplicate_count": false,
    "show_indicators": false,
    "separator_color": "frame",
    "separator_height": 2,
    "progress_bar": true,
    "progress_bar_height": 6,
    "progress_bar_frame_width": 1,
    "sticky_history": true,
    "history_length": 20,
    "alignment": "left",
    "vertical_alignment": "center",
    "log_level": "warn",
    "log_file": "~/.local/share/dunst/dunst.log",
    "timeout_low": 5,
    "timeout_normal": 10,
    "timeout_critical": 0
  },
  "picom": {
    "backend": "glx",
    "active_opacity": 1.0,
    "inactive_opacity": 1.0,
    "fade": true,
    "fade_steps": [0.04, 0.04],
    "opacity_rules": ["100:class_g = 'rofi'"],
    "corner_radius": 12
  },
  "gtk": {
    "theme": "Orchis-Dark",
    "icon_theme": "Papirus-Dark",
    "cursor_theme": "Bibata-Modern-Ice",
    "cursor_size": 24
  },
  "rofi": {
    "font": "JetBrainsMono Nerd Font",
    "font_size": 14,
    "modes": ["drun", "run", "window", "ssh", "calc"]
  },
  "fastfetch": {
    "logo_width": 30,
    "logo_height": 15
  },
  "yazi": {
    "ratio": [2, 4, 3],
    "editor": "nvim"
  },
  "qtile": {
    "mod_key": "mod4",
    "log_dir": "~/.local/state/qtile",
    "power_menu_script": "qtile-power-menu",
    "qtile_help_script": "qtile-help"
  },
  "wezterm": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_size": 14.0,
    "opacity": 0.92,
    "padding": 12
  }
}
